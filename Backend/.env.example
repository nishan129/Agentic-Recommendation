# --- App ---
APP_NAME="Agentic Recommendation System"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Async URL used by the app at runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recsys
# Sync URL used by Alembic migrations (psycopg2)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/recsys

# --- Security / JWT ---
SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Event ingestion ---
EVENT_BATCH_MAX_SIZE=100
EVENT_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Recommendations ---
RECOMMENDATION_MODEL_VERSION=v1
RECOMMENDATION_DEFAULT_LIMIT=10
